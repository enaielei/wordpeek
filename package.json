{
  "name": "wordpeek",
  "version": "0.3.0",
  "private": true,
  "description": "A little clarity, right where you read. An online desktop dictionary for English learners.",
  "author": "enaielei",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "brand:icons": "node scripts/icons.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate",
    "test:desktop": "npm run build && node scripts/verify-desktop.mjs",
    "test:settings": "npm run build && node scripts/verify-settings.mjs",
    "test:zoom": "npm run build && node scripts/verify-zoom.mjs",
    "prebuild": "node scripts/build-native.mjs",
    "predev": "node scripts/build-native.mjs",
    "prestart": "node scripts/build-native.mjs",
    "test:selection": "npm run build && node scripts/verify-selection.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "io.github.enaielei.wordpeek",
    "productName": "WordPeek",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets/brand"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/brand/icon.png",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "shared/**",
      "assets/fonts/OFL-Manrope.txt"
    ],
    "asarUnpack": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/brand/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "native/bin/WordPeek.Native.exe",
        "to": "native/WordPeek.Native.exe"
      }
    ]
  }
}
